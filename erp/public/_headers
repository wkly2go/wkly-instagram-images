# 화면 뼈대·버전 파일은 매번 새로 확인 (배포가 바로 보이게), 해시가 붙은 파일은 오래 보관
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

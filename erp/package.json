{
  "name": "wkly-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:marketing": "node --experimental-strip-types --test tests/ad-workspace.test.ts tests/marketing.test.ts tests/marketing-save.test.ts tests/marketing-db.test.mjs",
    "test:efficiency": "node --experimental-strip-types --test tests/navigation-counts.test.ts tests/pending-reads.test.ts tests/signed-url-cache.test.ts tests/collaboration-polling.test.ts tests/upload-record.test.ts tests/storage-removal.test.ts tests/meeting-cleanup.test.mjs tests/supabase-storage-flow.test.mjs tests/egress-savings.test.mjs",
    "test:sales": "node --experimental-strip-types --test tests/sales.test.ts tests/sales-navigation.test.ts tests/sales-db.test.mjs",
    "test:growth": "node --experimental-strip-types --test tests/growth.test.ts tests/navigation-guard.test.ts tests/contact-import.test.ts tests/growth-db.test.mjs tests/growth-ai-handler.test.ts tests/growth-ai-dashboard.test.mjs",
    "build:growth-dashboard": "node scripts/build-growth-ai-dashboard.mjs",
    "build:meeting-dashboard": "node scripts/build-meeting-minutes-dashboard.mjs",
    "test:meeting": "node --experimental-strip-types --test tests/meeting-cleanup.test.mjs tests/meeting-dashboard.test.mjs tests/meeting-processing.test.mjs tests/meeting-progress.test.ts",
    "test:ui": "node --test tests/ui/growth-dom.test.mjs",
    "build:g2b-dashboard": "node scripts/build-g2b-dashboard.mjs",
    "test:g2b": "node --experimental-strip-types --test tests/g2b-handler.test.ts tests/g2b-dashboard.test.mjs tests/tender-search.test.mjs",
    "test:all": "node --experimental-strip-types --test --test-concurrency=2 tests/*.test.ts tests/*.test.mjs",
    "build:gmail-dashboard": "node scripts/build-gmail-dashboard.mjs",
    "test:gmail": "node --experimental-strip-types --test tests/gmail-sync.test.mjs tests/gmail-sync-handler.test.mjs tests/gmail-dashboard.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "fflate": "^0.8.2",
    "lucide-react": "^0.460.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@testing-library/dom": "10.4.1",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "26.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  }
}
